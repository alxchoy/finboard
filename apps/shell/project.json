{
  "name": "@finboard/shell",
  "projectType": "application",
  "tags": ["scope:app"],
  "targets": {
    "serve": {
      "executor": "@nx/vite:dev-server",
      "options": {
        "buildTarget": "@finboard/shell:build"
      }
    },
    "build": {
      "executor": "@nx/vite:build",
      "options": {
        "outputPath": "dist/apps/shell"
      }
    },
    "preview": {
      "executor": "@nx/vite:preview",
      "options": {
        "buildTarget": "@finboard/shell:build"
      }
    }
  }
}
